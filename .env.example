# Storefront environment configuration. Replace example values before deployment.
# Public values are included in browser bundles; do not put secrets here.

# Required: Admin API origin used by the storefront's same-origin API rewrite.
# Do not include /api or the store ID; this value stays server-side.
ADMIN_API_ORIGIN=http://localhost:3000

# Required: Admin API base including this store's ID, without a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/<storeId>

# Optional: Store ID fallback when it cannot be derived from the API URL.
NEXT_PUBLIC_STORE_ID=<storeId>

# Optional: Public storefront origin used for robots and image sitemap URLs.
NEXT_PUBLIC_STORE_URL=https://store.example.com

# Optional: Fallback Razorpay public key ID for exchange payments.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_example

# Optional: Contact email shown for unavailable delivery pincodes; defaults to site config.
NEXT_PUBLIC_SERVICE_EMAIL=support@example.com